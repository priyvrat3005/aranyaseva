# PlantConnect Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (safe for frontend use)
# IMPORTANT: Never use the service_role key here - it bypasses RLS!
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# MCP SERVER CONFIGURATION (Apper.io)
# ============================================
# The MCP server is configured in .qwen/settings.json
# No environment variables needed for MCP

# ============================================
# OPTIONAL: ADDITIONAL SERVICES
# ============================================

# Razorpay (for payments)
# VITE_RAZORPAY_KEY_ID=your-razorpay-key

# Google Maps (for location features)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Cloudinary (for image uploads)
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit .env to git (it's in .gitignore)
# 2. NEVER use service_role key in frontend code
# 3. Use Row Level Security (RLS) policies in Supabase
# 4. All access control is enforced by RLS, not just UI
# 5. Service-role key is only for server-side operations (Edge Functions)
